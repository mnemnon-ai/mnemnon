# ─── Secrets & environment ───────────────────────────────
# Never commit real secrets. Keep the committed template (.env.example).
.env
.env.*
!.env.example
*.key
*.pem
secrets/

# ─── Python (gateway: FastAPI / Starlette) ───────────────
__pycache__/
*.py[cod]
*$py.class
.Python
.venv/
venv/
env/
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ─── Docker / local stack data ───────────────────────────
# Named volumes live in Docker; ignore any bind-mounted local data dirs.
data/
*.sqlite
*.sqlite3
*.db

# ─── Logs ────────────────────────────────────────────────
*.log
logs/

# ─── Editors / tooling ───────────────────────────────────
.vscode/
.idea/
*.swp

# ─── macOS (i9 + M4 dev machines) ────────────────────────
.DS_Store
.AppleDouble
.LSOverride
